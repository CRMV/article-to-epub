{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["vitest/globals", "@testing-library/jest-dom", "chrome"]
  },
  "include": [
    "entrypoints",
    "src",
    "tests",
    ".wxt/wxt.d.ts",
    "wxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
